# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Next.js (apps/web) — public, browser-exposed; must match API origin in dev
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/property_ops

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Express legacy API) — required for apps/api; use openssl rand -base64 48 (two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Auth.js (apps/web) — use same values in apps/web/.env.local
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# WhatsApp (placeholder)
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
