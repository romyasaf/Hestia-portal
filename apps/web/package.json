{
  "name": "@hestia/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "tsx scripts/validate-db-schema.ts",
    "db:apply-015": "tsx scripts/run-prisma-with-env.ts db execute --file ../../db/migrations/015_property_structured_address.sql --schema prisma/schema.prisma",
    "db:apply-016": "tsx scripts/run-prisma-with-env.ts db execute --file ../../db/migrations/016_checkin_inventory_master.sql --schema prisma/schema.prisma",
    "db:apply-017": "tsx scripts/run-prisma-with-env.ts db execute --file ../../db/migrations/017_owner_contracts.sql --schema prisma/schema.prisma",
    "db:apply-030": "tsx scripts/run-prisma-with-env.ts db execute --file ../../db/migrations/030_unit_system_core.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@hestia/config": "workspace:*",
    "@prisma/client": "^6.3.1",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "next-auth": "5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  }
}
