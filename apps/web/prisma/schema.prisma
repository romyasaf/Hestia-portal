// Hestia Portal — Prisma schema aligned with PostgreSQL DDL.
//
// Canonical SQL: `db/schema.sql` (greenfield). Incremental upgrades: `db/migrations/*.sql` in order.
// Do not use `prisma db push` against production unless you accept drift from the SQL files; see `db/MIGRATIONS.md`.
// After DDL changes: apply SQL, then `pnpm db:generate` from `apps/web`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles    UserRole[]
  ownedProperties Property[] @relation("PropertyOwner")
  ownedUnits      Unit[]     @relation("UnitDirectOwner")
  leasesAsTenant Lease[] @relation("LeaseTenant")
  ticketsOpened Ticket[] @relation("TicketOpenedBy")
  ticketsAssigned Ticket[] @relation("TicketAssignedTo")
  jobsRequested Job[] @relation("JobRequester")
  invoices      Invoice[]
  receiptsRecorded Receipt[] @relation("ReceiptRecordedBy")
  leaseCheckIns LeaseCheckIn[] @relation("LeaseCheckInTenant")
  leaseCheckouts LeaseCheckOut[] @relation("LeaseCheckoutTenant")
  chequeApprovalsForLeases Lease[] @relation("ChequeApprovedBy")
  maintenanceAttachmentsUploaded MaintenanceAttachment[] @relation("AttachmentUploadedBy")
  passwordResetTokens            PasswordResetToken[]
  staffPermissionGrants          StaffPermissionGrant[]
  convertedFromLeadInquiries   LeadInquiry[] @relation("LeadConvertedTenant")
  ownerContracts               OwnerContract[] @relation("OwnerContractParty")
  ownerProfile                 OwnerProfile?
  tenantProfile                TenantProfile?
  leasesChequeReceivedBy       Lease[] @relation("LeaseChequeReceivedBy")

  @@map("users")
}

model OwnerProfile {
  userId                     String    @id @map("user_id") @db.Uuid
  ownerType                  String    @default("individual") @map("owner_type")
  /** building_owner = whole building; unit_owner = specific unit(s) only. */
  ownershipScope             String    @default("building_owner") @map("ownership_scope")
  whatsAppPhone              String?   @map("whats_app_phone")
  addressLine                String?   @map("address_line") @db.Text
  notes                      String?   @db.Text
  qidNumber                  String?   @map("qid_number")
  qidExpiry                  DateTime? @map("qid_expiry") @db.Date
  qidPhotoUrl                String?   @map("qid_photo_url")
  commercialRegistrationNumber String? @map("commercial_registration_number")
  crDocumentUrl              String?   @map("cr_document_url")
  defaultOwnerContractType   String    @default("managed") @map("default_owner_contract_type")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_profiles")
}

model TenantProfile {
  userId                       String    @id @map("user_id") @db.Uuid
  tenantType                   String    @default("individual") @map("tenant_type")
  tenantLifecycleStatus        String    @default("active") @map("tenant_lifecycle_status")
  whatsAppPhone                String?   @map("whats_app_phone")
  nationality                  String?
  qidNumber                    String?   @map("qid_number")
  qidExpiry                    DateTime? @map("qid_expiry") @db.Date
  qidPhotoUrl                  String?   @map("qid_photo_url")
  passportNumber               String?   @map("passport_number")
  passportPhotoUrl             String?   @map("passport_photo_url")
  dateOfBirth                  DateTime? @map("date_of_birth") @db.Date
  companyName                  String?   @map("company_name")
  contactPersonName            String?   @map("contact_person_name")
  commercialRegistrationNumber String? @map("commercial_registration_number")
  crDocumentUrl                String?   @map("cr_document_url")
  companyAddress               String?   @map("company_address") @db.Text
  authorizedSignatory          String?   @map("authorized_signatory")
  emergencyContactName         String?   @map("emergency_contact_name")
  emergencyContactPhone        String?   @map("emergency_contact_phone")
  emergencyContactRelationship String?   @map("emergency_contact_relationship")
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model StaffPermissionGrant {
  userId           String   @map("user_id") @db.Uuid
  permissionCode   String   @map("permission_code")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("staff_permission_grants")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Property {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String   @unique
  name                 String
  addressZone          String   @map("address_zone")
  addressStreet        String   @map("address_street")
  addressBuildingNumber String  @map("address_building_number")
  addressAreaName      String?  @map("address_area_name")
  addressNotes         String?  @map("address_notes")
  city                 String
  country              String   @default("Qatar")
  ownerUserId          String?  @map("owner_user_id") @db.Uuid
  ownerFinancialAccess Boolean  @default(false) @map("owner_financial_access")
  /** Building-level owner contract: operator = landlord to company (restricted portal); managed = under management (full). */
  ownerContractType    String   @default("managed") @map("owner_contract_type")
  /** Physical asset classification. Optional in Prisma so INSERT omits the column until migration 025; DB default applies when the column exists. */
  propertyType         String?  @map("property_type")
  /** Managed vs location-only. Optional in Prisma for the same reason as `propertyType`. */
  managementStatus     String?  @map("management_status")
  googleMapsUrl        String?  @map("google_maps_url")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                User?    @relation("PropertyOwner", fields: [ownerUserId], references: [id])
  units         Unit[]
  tickets       Ticket[]
  jobs          Job[]
  expenses      Expense[]
  announcements Announcement[]
  ownerContracts  OwnerContract[]

  @@map("properties")
}

model Unit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  /** Optional owner of this unit only (overrides building-level owner for resolution). */
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  unitNumber    String   @map("unit_number")
  unitType      String?  @map("unit_type")
  floor         String?
  bedrooms      Int?
  bathrooms     Int?
  monthlyRent   Decimal? @map("monthly_rent") @db.Decimal(12, 2)
  /** Size in m² (optional). */
  areaSqm        Decimal? @map("area_sqm") @db.Decimal(12, 2)
  /** unfurnished | semi_furnished | furnished | unknown */
  furnishingStatus String? @map("furnishing_status")
  status        String   @default("available")
  /** How this unit links to owner contracts (building-level vs direct). */
  ownershipSource String @default("no_owner_contract") @map("ownership_source")
  listingTitle           String?   @map("listing_title")
  listingDescription     String?   @map("listing_description") @db.Text
  listingMonthlyPrice    Decimal?  @map("listing_monthly_price") @db.Decimal(12, 2)
  listingAmenities       Json      @default("[]") @map("listing_amenities")
  listingCoverImageUrl   String?   @map("listing_cover_image_url")
  listingGalleryUrls     Json      @default("[]") @map("listing_gallery_urls")
  /** Internal marketing notes; never on public site. */
  listingNotes            String?   @map("listing_notes") @db.Text
  /** First date the unit is marketed as available (optional). */
  listingAvailabilityDate DateTime? @map("listing_availability_date") @db.Date
  /** JSON array of { id, label, defaultCondition? } for move-in inventory during tenant onboarding. */
  checkinInventoryTemplate Json @default("[]") @map("checkin_inventory_template")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner         User?    @relation("UnitDirectOwner", fields: [ownerUserId], references: [id])
  leases        Lease[]
  tickets       Ticket[]
  jobs          Job[]
  expenses        Expense[]
  ownerContracts  OwnerContract[]
  inventoryItems  UnitInventoryItem[]

  @@unique([propertyId, unitNumber])
  @@map("units")
}

model UnitInventoryItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId          String   @map("unit_id") @db.Uuid
  itemName        String   @map("item_name")
  category        String
  quantity        Decimal  @default(1) @db.Decimal(12, 2)
  conditionLabel  String   @default("good") @map("condition_label")
  notes           String?
  photoUrl        String?  @map("photo_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  checkInLineRefs LeaseCheckInLine[]

  @@index([unitId])
  @@map("unit_inventory_items")
}

/**
 * Company ↔ owner agreement (rent we pay an owner). Separate from tenant leases.
 * `contract_type`: legacy `operator` | `managed`, plus `fixed_lease` | `property_management` from owner onboarding.
 */
model OwnerContract {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String    @map("owner_user_id") @db.Uuid
  propertyId         String?   @map("property_id") @db.Uuid
  unitId             String?   @map("unit_id") @db.Uuid
  /** Where the agreement applies: whole asset, selected units, or whole villa property. */
  propertyScope      String?   @map("property_scope")
  contractType       String    @map("contract_type")
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime  @map("end_date") @db.Date
  /** Derived from dates vs today: upcoming | active | expired. */
  contractStatus       String?   @map("contract_status")
  paymentFrequency     String    @default("monthly") @map("payment_frequency")
  amount               Decimal   @db.Decimal(12, 2)
  managementFeeStructure       String?   @map("management_fee_structure")
  managementFeePercentage      Decimal?  @map("management_fee_percentage") @db.Decimal(6, 3)
  monthlyManagementFeeAmount   Decimal?  @map("monthly_management_fee_amount") @db.Decimal(12, 2)
  revenueCalculationMethod     String?   @map("revenue_calculation_method")
  /** When non-null, contract covers multiple units (same terms); otherwise use unitId only. */
  appliesToUnitIds     Json?     @map("applies_to_unit_ids")
  documentUrl          String?   @map("document_url")
  notes                String?   @map("notes")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                User      @relation("OwnerContractParty", fields: [ownerUserId], references: [id])
  property             Property? @relation(fields: [propertyId], references: [id])
  unit                 Unit?     @relation(fields: [unitId], references: [id])
  expenses             Expense[]
  receipts             Receipt[]

  @@map("owner_contracts")
}

/** Global move-in checklist template; merged with `Unit.checkinInventoryTemplate` when seeding lease onboarding. Never exposed on public listings. */
model CheckinInventoryMasterItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  itemName      String   @map("item_name")
  conditionHint String?  @map("condition_hint")
  notes         String?  @map("notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("checkin_inventory_master_items")
}

model Lease {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  tenantUserId   String   @map("tenant_user_id") @db.Uuid
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  rentAmount     Decimal  @map("rent_amount") @db.Decimal(12, 2)
  depositAmount  Decimal  @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  status         String   @default("active")
  contractSignedAt        DateTime? @map("contract_signed_at") @db.Timestamptz(6)
  contractSignerName      String?   @map("contract_signer_name")
  chequeDeliveryState     String    @default("pending") @map("cheque_delivery_state")
  chequeAppointmentAt     DateTime? @map("cheque_appointment_at") @db.Timestamptz(6)
  chequeAppointmentNotes  String?   @map("cheque_appointment_notes")
  chequeMarkedDeliveredAt DateTime? @map("cheque_marked_delivered_at") @db.Timestamptz(6)
  chequeApprovedAt        DateTime? @map("cheque_approved_at") @db.Timestamptz(6)
  chequeApprovedByUserId  String?   @map("cheque_approved_by_user_id") @db.Uuid
  chequeReceivedAt        DateTime? @map("cheque_received_at") @db.Timestamptz(6)
  chequeReceivedByUserId  String?   @map("cheque_received_by_user_id") @db.Uuid
  paymentFrequency        String    @default("monthly") @map("payment_frequency")
  digitalSignatureStatus  String    @default("none") @map("digital_signature_status")
  unsignedContractDocumentUrl String? @map("unsigned_contract_document_url")
  signedContractDocumentUrl     String? @map("signed_contract_document_url")
  onboardingContractSigned      Boolean @default(false) @map("onboarding_contract_signed")
  onboardingChequeReceived       Boolean @default(false) @map("onboarding_cheque_received")
  onboardingCheckinCompleted    Boolean @default(false) @map("onboarding_checkin_completed")
  onboardingCompletedAt   DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  /** JSON: move-in inventory rows during onboarding before LeaseCheckIn is created. */
  onboardingCheckinInventory Json @default("[]") @map("onboarding_checkin_inventory")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chequeApprovedBy        User?    @relation("ChequeApprovedBy", fields: [chequeApprovedByUserId], references: [id])
  chequeReceivedBy        User?    @relation("LeaseChequeReceivedBy", fields: [chequeReceivedByUserId], references: [id])
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant         User     @relation("LeaseTenant", fields: [tenantUserId], references: [id])
  invoices       Invoice[]
  tickets        Ticket[]
  checkIns       LeaseCheckIn[]
  checkouts      LeaseCheckOut[]
  expenses       Expense[]
  receipts       Receipt[]

  @@map("leases")
}

model LeaseCheckIn {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId      String   @map("lease_id") @db.Uuid
  tenantUserId String   @map("tenant_user_id") @db.Uuid
  status       String   @default("submitted")
  tenantNotes  String?  @map("tenant_notes")
  adminNotes   String?  @map("admin_notes")
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lease        Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant       User     @relation("LeaseCheckInTenant", fields: [tenantUserId], references: [id])
  issues       LeaseCheckInIssue[]
  lineItems    LeaseCheckInLine[]

  @@map("lease_check_ins")
}

/** Per line-item move-in check-in: confirms or issues tied to template or inventory. */
model LeaseCheckInLine {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkInId          String   @map("check_in_id") @db.Uuid
  lineKey            String   @map("line_key")
  lineLabel          String?  @map("line_label")
  unitInventoryItemId String?  @map("unit_inventory_item_id") @db.Uuid
  outcome            String
  issueDescription  String?  @map("issue_description") @db.Text
  issuePhotoUrl     String?  @map("issue_photo_url")
  tenantLineNotes   String?  @map("tenant_line_notes") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkIn           LeaseCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  unitInventoryItem UnitInventoryItem? @relation(fields: [unitInventoryItemId], references: [id], onDelete: SetNull)

  @@unique([checkInId, lineKey])
  @@index([checkInId])
  @@map("lease_check_in_lines")
}

model LeaseCheckInIssue {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkInId         String        @map("check_in_id") @db.Uuid
  summary           String
  details           String?
  severity          String        @default("medium")
  areaLabel         String?       @map("area_label")
  convertedTicketId String?       @unique @map("converted_ticket_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  checkIn           LeaseCheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  convertedTicket   Ticket?       @relation("CheckInIssueTicket", fields: [convertedTicketId], references: [id])

  @@map("lease_check_in_issues")
}

model LeaseCheckOut {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId              String    @map("lease_id") @db.Uuid
  tenantUserId         String    @map("tenant_user_id") @db.Uuid
  status               String    @default("requested")
  tenantNotes          String?   @map("tenant_notes")
  preferredMoveOutDate DateTime? @map("preferred_move_out_date") @db.Date
  scheduledAt          DateTime? @map("scheduled_at") @db.Timestamptz(6)
  adminNotes           String?   @map("admin_notes")
  inspectionOutcome    String?   @map("inspection_outcome")
  damagesSummary       String?   @map("damages_summary")
  /** Notes from the walk-through before final decision. */
  inspectionNotes      String?  @map("inspection_notes") @db.Text
  /** Admin summary of deposit / liability decision. */
  finalDecisionNotes  String?   @map("final_decision_notes") @db.Text
  deductionAmount      Decimal?  @map("deduction_amount") @db.Decimal(12, 2)
  depositReturnAmount  Decimal?  @map("deposit_return_amount") @db.Decimal(12, 2)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lease                Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant               User      @relation("LeaseCheckoutTenant", fields: [tenantUserId], references: [id])
  expenses             Expense[]
  receipts             Receipt[]

  @@map("lease_checkouts")
}

model Ticket {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNo           String    @unique @map("ticket_no")
  propertyId         String    @map("property_id") @db.Uuid
  unitId             String?   @map("unit_id") @db.Uuid
  leaseId            String?   @map("lease_id") @db.Uuid
  openedByUserId     String    @map("opened_by_user_id") @db.Uuid
  assignedToUserId   String?   @map("assigned_to_user_id") @db.Uuid
  category           String
  priority           String    @default("medium")
  status             String    @default("Pending Review")
  title              String
  description        String?
  quotedAmount       Decimal?  @map("quoted_amount") @db.Decimal(12, 2)
  quoteDescription   String?   @map("quote_description")
  internalCost       Decimal?  @map("internal_cost") @db.Decimal(12, 2)
  approvalNeeded     Boolean   @default(false) @map("approval_needed")
  permissionToEnter  Boolean   @default(false) @map("permission_to_enter")
  appointmentAt      DateTime? @map("appointment_at") @db.Timestamptz(6)
  openedAt           DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  property           Property  @relation(fields: [propertyId], references: [id])
  unit               Unit?     @relation(fields: [unitId], references: [id])
  lease              Lease?    @relation(fields: [leaseId], references: [id])
  openedBy           User      @relation("TicketOpenedBy", fields: [openedByUserId], references: [id])
  assignedTo         User?     @relation("TicketAssignedTo", fields: [assignedToUserId], references: [id])
  expenses           Expense[]
  receipts           Receipt[]
  attachments        MaintenanceAttachment[]
  sourceCheckInIssue LeaseCheckInIssue?      @relation("CheckInIssueTicket")

  @@map("tickets")
}

model MaintenanceAttachment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maintenanceTicketId String  @map("maintenance_ticket_id") @db.Uuid
  fileUrl              String   @map("file_url")
  fileType             String?  @map("file_type")
  uploadedByUserId   String   @map("uploaded_by_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket               Ticket   @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  uploadedBy           User     @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@map("maintenance_attachments")
}

model Announcement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  body          String
  audienceType  String    @default("all") @map("audience_type")
  propertyId    String?   @map("property_id") @db.Uuid
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  property      Property? @relation(fields: [propertyId], references: [id])

  @@map("announcements")
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobNo           String    @unique @map("job_no")
  sourceType      String    @map("source_type")
  sourceId        String?   @map("source_id") @db.Uuid
  requesterUserId String    @map("requester_user_id") @db.Uuid
  propertyId      String?   @map("property_id") @db.Uuid
  unitId          String?   @map("unit_id") @db.Uuid
  requestKind     String?   @map("request_kind")
  title           String
  scope           String?
  status          String    @default("draft")
  estimatedAmount Decimal?  @map("estimated_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal?  @map("approved_amount") @db.Decimal(12, 2)
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  requester       User      @relation("JobRequester", fields: [requesterUserId], references: [id])
  property        Property? @relation(fields: [propertyId], references: [id])
  unit            Unit?     @relation(fields: [unitId], references: [id])
  invoices        Invoice[]
  expenses        Expense[]

  @@map("jobs")
}

model Invoice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNo     String    @unique @map("invoice_no")
  userId        String    @map("user_id") @db.Uuid
  leaseId       String?   @map("lease_id") @db.Uuid
  jobId         String?   @map("job_id") @db.Uuid
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  status        String    @default("draft")
  paymentStatus String    @default("unpaid") @map("payment_status")
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  user          User      @relation(fields: [userId], references: [id])
  lease         Lease?    @relation(fields: [leaseId], references: [id])
  job           Job?      @relation(fields: [jobId], references: [id])
  payments      Payment[]
  receipts      Receipt[]

  @@map("invoices")
}

model Payment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  paidAt      DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  referenceNo String?  @map("reference_no")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Expense {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String?        @map("property_id") @db.Uuid
  unitId          String?        @map("unit_id") @db.Uuid
  leaseId         String?        @map("lease_id") @db.Uuid
  ticketId        String?        @map("ticket_id") @db.Uuid
  jobId           String?        @map("job_id") @db.Uuid
  leaseCheckoutId String?        @map("lease_checkout_id") @db.Uuid
  ownerContractId String?        @map("owner_contract_id") @db.Uuid
  category        String
  subcategory     String?
  amount          Decimal        @db.Decimal(12, 2)
  vendorName      String?        @map("vendor_name")
  expenseDate     DateTime       @map("expense_date") @db.Date
  paymentStatus   String         @default("pending") @map("payment_status")
  notes           String?
  property        Property?      @relation(fields: [propertyId], references: [id])
  unit            Unit?          @relation(fields: [unitId], references: [id])
  lease           Lease?         @relation(fields: [leaseId], references: [id])
  ticket          Ticket?        @relation(fields: [ticketId], references: [id])
  job             Job?           @relation(fields: [jobId], references: [id])
  leaseCheckout   LeaseCheckOut? @relation(fields: [leaseCheckoutId], references: [id])
  ownerContract   OwnerContract? @relation(fields: [ownerContractId], references: [id])

  @@map("expenses")
}

model Receipt {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNo          String         @unique @map("receipt_no")
  leaseId            String?        @map("lease_id") @db.Uuid
  ticketId           String?        @map("ticket_id") @db.Uuid
  invoiceId          String?        @map("invoice_id") @db.Uuid
  leaseCheckoutId    String?        @map("lease_checkout_id") @db.Uuid
  ownerContractId    String?        @map("owner_contract_id") @db.Uuid
  sourceReceiptId    String?        @map("source_receipt_id") @db.Uuid
  category           String?
  subcategory        String?
  amount             Decimal        @db.Decimal(12, 2)
  receivedAt         DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  method             String
  referenceNo        String?        @map("reference_no")
  paymentStatus      String         @default("recorded") @map("payment_status")
  notes              String?
  recordedByUserId   String?        @map("recorded_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lease              Lease?         @relation(fields: [leaseId], references: [id])
  ticket             Ticket?        @relation(fields: [ticketId], references: [id])
  invoice            Invoice?       @relation(fields: [invoiceId], references: [id])
  leaseCheckout      LeaseCheckOut? @relation(fields: [leaseCheckoutId], references: [id])
  ownerContract      OwnerContract? @relation(fields: [ownerContractId], references: [id])
  sourceReceipt      Receipt?       @relation("CommissionFromRentReceipt", fields: [sourceReceiptId], references: [id])
  commissionChildren Receipt[]      @relation("CommissionFromRentReceipt")
  recordedBy         User?          @relation("ReceiptRecordedBy", fields: [recordedByUserId], references: [id])

  @@map("receipts")
}

model InventoryItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku             String   @unique
  name            String
  unitOfMeasure   String   @default("pcs") @map("unit_of_measure")
  quantityOnHand  Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  reorderLevel    Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 2)
  stockTransactions StockTransaction[]

  @@map("inventory_items")
}

model StockTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  txnType       String   @map("txn_type")
  quantity      Decimal  @db.Decimal(12, 2)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("stock_transactions")
}

model LeadInquiry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryType  String   @map("inquiry_type")
  status       String   @default("new")
  fullName     String   @map("full_name")
  phone        String
  email        String
  message      String
  context      Json?    @db.JsonB
  convertedTenantUserId String?   @map("converted_tenant_user_id") @db.Uuid
  convertedAt           DateTime? @map("converted_at") @db.Timestamptz(6)
  convertedTenant       User?     @relation("LeadConvertedTenant", fields: [convertedTenantUserId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([inquiryType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([convertedTenantUserId])
  @@map("lead_inquiries")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}
