// Hestia Portal — Prisma schema aligned with PostgreSQL DDL.
//
// Canonical SQL: `db/schema.sql` (greenfield). Incremental upgrades: `db/migrations/*.sql` in order.
// Do not use `prisma db push` against production unless you accept drift from the SQL files; see `db/MIGRATIONS.md`.
// After DDL changes: apply SQL, then `pnpm db:generate` from `apps/web`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles    UserRole[]
  ownedProperties Property[] @relation("PropertyOwner")
  ownedUnits      Unit[]     @relation("UnitDirectOwner")
  leasesAsTenant Lease[] @relation("LeaseTenant")
  ticketsOpened Ticket[] @relation("TicketOpenedBy")
  ticketsAssigned Ticket[] @relation("TicketAssignedTo")
  jobsRequested Job[] @relation("JobRequester")
  invoices      Invoice[]
  receiptsRecorded Receipt[] @relation("ReceiptRecordedBy")
  leaseCheckIns LeaseCheckIn[] @relation("LeaseCheckInTenant")
  leaseCheckouts LeaseCheckOut[] @relation("LeaseCheckoutTenant")
  chequeApprovalsForLeases Lease[] @relation("ChequeApprovedBy")
  maintenanceAttachmentsUploaded MaintenanceAttachment[] @relation("AttachmentUploadedBy")
  passwordResetTokens            PasswordResetToken[]
  staffPermissionGrants          StaffPermissionGrant[]
  convertedFromLeadInquiries   LeadInquiry[] @relation("LeadConvertedTenant")

  @@map("users")
}

model StaffPermissionGrant {
  userId           String   @map("user_id") @db.Uuid
  permissionCode   String   @map("permission_code")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("staff_permission_grants")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Property {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String   @unique
  name                 String
  addressLine1         String   @map("address_line_1")
  city                 String
  country              String   @default("Qatar")
  ownerUserId          String?  @map("owner_user_id") @db.Uuid
  ownerFinancialAccess Boolean  @default(false) @map("owner_financial_access")
  /** Building-level owner contract: operator = landlord to company (restricted portal); managed = under management (full). */
  ownerContractType    String   @default("managed") @map("owner_contract_type")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner                User?    @relation("PropertyOwner", fields: [ownerUserId], references: [id])
  units         Unit[]
  tickets       Ticket[]
  jobs          Job[]
  expenses      Expense[]
  announcements Announcement[]

  @@map("properties")
}

model Unit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  /** Optional owner of this unit only (overrides building-level owner for resolution). */
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  unitNumber    String   @map("unit_number")
  unitType      String?  @map("unit_type")
  bedrooms      Int?
  bathrooms     Int?
  monthlyRent   Decimal? @map("monthly_rent") @db.Decimal(12, 2)
  status        String   @default("available")
  listingTitle           String?   @map("listing_title")
  listingDescription     String?   @map("listing_description") @db.Text
  listingMonthlyPrice    Decimal?  @map("listing_monthly_price") @db.Decimal(12, 2)
  listingAmenities       Json      @default("[]") @map("listing_amenities")
  listingCoverImageUrl   String?   @map("listing_cover_image_url")
  listingGalleryUrls     Json      @default("[]") @map("listing_gallery_urls")
  /** JSON array of { id, label, defaultCondition? } for move-in inventory during tenant onboarding. */
  checkinInventoryTemplate Json @default("[]") @map("checkin_inventory_template")
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner         User?    @relation("UnitDirectOwner", fields: [ownerUserId], references: [id])
  leases        Lease[]
  tickets       Ticket[]
  jobs          Job[]
  expenses      Expense[]

  @@unique([propertyId, unitNumber])
  @@map("units")
}

model Lease {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  tenantUserId   String   @map("tenant_user_id") @db.Uuid
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  rentAmount     Decimal  @map("rent_amount") @db.Decimal(12, 2)
  depositAmount  Decimal  @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  status         String   @default("active")
  contractSignedAt        DateTime? @map("contract_signed_at") @db.Timestamptz(6)
  contractSignerName      String?   @map("contract_signer_name")
  chequeDeliveryState     String    @default("pending") @map("cheque_delivery_state")
  chequeAppointmentAt     DateTime? @map("cheque_appointment_at") @db.Timestamptz(6)
  chequeAppointmentNotes  String?   @map("cheque_appointment_notes")
  chequeMarkedDeliveredAt DateTime? @map("cheque_marked_delivered_at") @db.Timestamptz(6)
  chequeApprovedAt        DateTime? @map("cheque_approved_at") @db.Timestamptz(6)
  chequeApprovedByUserId  String?   @map("cheque_approved_by_user_id") @db.Uuid
  onboardingCompletedAt   DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  /** JSON: move-in inventory rows during onboarding before LeaseCheckIn is created. */
  onboardingCheckinInventory Json @default("[]") @map("onboarding_checkin_inventory")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chequeApprovedBy        User?    @relation("ChequeApprovedBy", fields: [chequeApprovedByUserId], references: [id])
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant         User     @relation("LeaseTenant", fields: [tenantUserId], references: [id])
  invoices       Invoice[]
  tickets        Ticket[]
  checkIns       LeaseCheckIn[]
  checkouts      LeaseCheckOut[]
  expenses       Expense[]
  receipts       Receipt[]

  @@map("leases")
}

model LeaseCheckIn {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId      String   @map("lease_id") @db.Uuid
  tenantUserId String   @map("tenant_user_id") @db.Uuid
  status       String   @default("submitted")
  tenantNotes  String?  @map("tenant_notes")
  adminNotes   String?  @map("admin_notes")
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lease        Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant       User     @relation("LeaseCheckInTenant", fields: [tenantUserId], references: [id])
  issues       LeaseCheckInIssue[]

  @@map("lease_check_ins")
}

model LeaseCheckInIssue {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkInId         String        @map("check_in_id") @db.Uuid
  summary           String
  details           String?
  severity          String        @default("medium")
  areaLabel         String?       @map("area_label")
  convertedTicketId String?       @unique @map("converted_ticket_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  checkIn           LeaseCheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  convertedTicket   Ticket?       @relation("CheckInIssueTicket", fields: [convertedTicketId], references: [id])

  @@map("lease_check_in_issues")
}

model LeaseCheckOut {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId              String    @map("lease_id") @db.Uuid
  tenantUserId         String    @map("tenant_user_id") @db.Uuid
  status               String    @default("requested")
  tenantNotes          String?   @map("tenant_notes")
  preferredMoveOutDate DateTime? @map("preferred_move_out_date") @db.Date
  scheduledAt          DateTime? @map("scheduled_at") @db.Timestamptz(6)
  adminNotes           String?   @map("admin_notes")
  inspectionOutcome    String?   @map("inspection_outcome")
  damagesSummary       String?   @map("damages_summary")
  deductionAmount      Decimal?  @map("deduction_amount") @db.Decimal(12, 2)
  depositReturnAmount  Decimal?  @map("deposit_return_amount") @db.Decimal(12, 2)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lease                Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant               User      @relation("LeaseCheckoutTenant", fields: [tenantUserId], references: [id])
  expenses             Expense[]
  receipts             Receipt[]

  @@map("lease_checkouts")
}

model Ticket {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNo           String    @unique @map("ticket_no")
  propertyId         String    @map("property_id") @db.Uuid
  unitId             String?   @map("unit_id") @db.Uuid
  leaseId            String?   @map("lease_id") @db.Uuid
  openedByUserId     String    @map("opened_by_user_id") @db.Uuid
  assignedToUserId   String?   @map("assigned_to_user_id") @db.Uuid
  category           String
  priority           String    @default("medium")
  status             String    @default("Pending Review")
  title              String
  description        String?
  quotedAmount       Decimal?  @map("quoted_amount") @db.Decimal(12, 2)
  quoteDescription   String?   @map("quote_description")
  internalCost       Decimal?  @map("internal_cost") @db.Decimal(12, 2)
  approvalNeeded     Boolean   @default(false) @map("approval_needed")
  permissionToEnter  Boolean   @default(false) @map("permission_to_enter")
  appointmentAt      DateTime? @map("appointment_at") @db.Timestamptz(6)
  openedAt           DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  property           Property  @relation(fields: [propertyId], references: [id])
  unit               Unit?     @relation(fields: [unitId], references: [id])
  lease              Lease?    @relation(fields: [leaseId], references: [id])
  openedBy           User      @relation("TicketOpenedBy", fields: [openedByUserId], references: [id])
  assignedTo         User?     @relation("TicketAssignedTo", fields: [assignedToUserId], references: [id])
  expenses           Expense[]
  receipts           Receipt[]
  attachments        MaintenanceAttachment[]
  sourceCheckInIssue LeaseCheckInIssue?      @relation("CheckInIssueTicket")

  @@map("tickets")
}

model MaintenanceAttachment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maintenanceTicketId String  @map("maintenance_ticket_id") @db.Uuid
  fileUrl              String   @map("file_url")
  fileType             String?  @map("file_type")
  uploadedByUserId   String   @map("uploaded_by_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket               Ticket   @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  uploadedBy           User     @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@map("maintenance_attachments")
}

model Announcement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  body          String
  audienceType  String    @default("all") @map("audience_type")
  propertyId    String?   @map("property_id") @db.Uuid
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  property      Property? @relation(fields: [propertyId], references: [id])

  @@map("announcements")
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobNo           String    @unique @map("job_no")
  sourceType      String    @map("source_type")
  sourceId        String?   @map("source_id") @db.Uuid
  requesterUserId String    @map("requester_user_id") @db.Uuid
  propertyId      String?   @map("property_id") @db.Uuid
  unitId          String?   @map("unit_id") @db.Uuid
  requestKind     String?   @map("request_kind")
  title           String
  scope           String?
  status          String    @default("draft")
  estimatedAmount Decimal?  @map("estimated_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal?  @map("approved_amount") @db.Decimal(12, 2)
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  requester       User      @relation("JobRequester", fields: [requesterUserId], references: [id])
  property        Property? @relation(fields: [propertyId], references: [id])
  unit            Unit?     @relation(fields: [unitId], references: [id])
  invoices        Invoice[]
  expenses        Expense[]

  @@map("jobs")
}

model Invoice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNo     String    @unique @map("invoice_no")
  userId        String    @map("user_id") @db.Uuid
  leaseId       String?   @map("lease_id") @db.Uuid
  jobId         String?   @map("job_id") @db.Uuid
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  status        String    @default("draft")
  paymentStatus String    @default("unpaid") @map("payment_status")
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  user          User      @relation(fields: [userId], references: [id])
  lease         Lease?    @relation(fields: [leaseId], references: [id])
  job           Job?      @relation(fields: [jobId], references: [id])
  payments      Payment[]
  receipts      Receipt[]

  @@map("invoices")
}

model Payment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  paidAt      DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  referenceNo String?  @map("reference_no")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Expense {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String?        @map("property_id") @db.Uuid
  unitId          String?        @map("unit_id") @db.Uuid
  leaseId         String?        @map("lease_id") @db.Uuid
  ticketId        String?        @map("ticket_id") @db.Uuid
  jobId           String?        @map("job_id") @db.Uuid
  leaseCheckoutId String?        @map("lease_checkout_id") @db.Uuid
  category        String
  subcategory     String?
  amount          Decimal        @db.Decimal(12, 2)
  vendorName      String?        @map("vendor_name")
  expenseDate     DateTime       @map("expense_date") @db.Date
  paymentStatus   String         @default("pending") @map("payment_status")
  notes           String?
  property        Property?      @relation(fields: [propertyId], references: [id])
  unit            Unit?          @relation(fields: [unitId], references: [id])
  lease           Lease?         @relation(fields: [leaseId], references: [id])
  ticket          Ticket?        @relation(fields: [ticketId], references: [id])
  job             Job?           @relation(fields: [jobId], references: [id])
  leaseCheckout   LeaseCheckOut? @relation(fields: [leaseCheckoutId], references: [id])

  @@map("expenses")
}

model Receipt {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNo          String         @unique @map("receipt_no")
  leaseId            String?        @map("lease_id") @db.Uuid
  ticketId           String?        @map("ticket_id") @db.Uuid
  invoiceId          String?        @map("invoice_id") @db.Uuid
  leaseCheckoutId    String?        @map("lease_checkout_id") @db.Uuid
  category           String?
  subcategory        String?
  amount             Decimal        @db.Decimal(12, 2)
  receivedAt         DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  method             String
  referenceNo        String?        @map("reference_no")
  paymentStatus      String         @default("recorded") @map("payment_status")
  notes              String?
  recordedByUserId   String?        @map("recorded_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lease              Lease?         @relation(fields: [leaseId], references: [id])
  ticket             Ticket?        @relation(fields: [ticketId], references: [id])
  invoice            Invoice?       @relation(fields: [invoiceId], references: [id])
  leaseCheckout      LeaseCheckOut? @relation(fields: [leaseCheckoutId], references: [id])
  recordedBy         User?          @relation("ReceiptRecordedBy", fields: [recordedByUserId], references: [id])

  @@map("receipts")
}

model InventoryItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku             String   @unique
  name            String
  unitOfMeasure   String   @default("pcs") @map("unit_of_measure")
  quantityOnHand  Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  reorderLevel    Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 2)
  stockTransactions StockTransaction[]

  @@map("inventory_items")
}

model StockTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  txnType       String   @map("txn_type")
  quantity      Decimal  @db.Decimal(12, 2)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("stock_transactions")
}

model LeadInquiry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryType  String   @map("inquiry_type")
  status       String   @default("new")
  fullName     String   @map("full_name")
  phone        String
  email        String
  message      String
  context      Json?    @db.JsonB
  convertedTenantUserId String?   @map("converted_tenant_user_id") @db.Uuid
  convertedAt           DateTime? @map("converted_at") @db.Timestamptz(6)
  convertedTenant       User?     @relation("LeadConvertedTenant", fields: [convertedTenantUserId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([inquiryType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([convertedTenantUserId])
  @@map("lead_inquiries")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}
