# Copy to .env.local for local dev

# Same database as docker compose / db/schema.sql
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/property_ops"

# Set to 1 to skip public-table checks on Next server boot (instrumentation). Default: validate when DATABASE_URL is set.
# SKIP_DB_VALIDATION=1

# Auth.js — generate with: openssl rand -base64 32 (min 16 chars; use 32+ in production)
AUTH_SECRET="replace_with_long_random_string"
# Public origin of this app (Auth.js). Production: https URL. Also accepted: APP_BASE_URL, NEXTAUTH_URL.
AUTH_URL="http://localhost:3000"

# Production password reset (Resend). Required together for forgot-password email.
# RESEND_API_KEY=
# EMAIL_FROM=
# Optional explicit origin for emails if different from AUTH_URL:
# APP_BASE_URL=

# Public API URL for /dev playground (Express legacy)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# When 1, log JSON lines to stdout when admin/super_admin opens tenant/staff/owner layouts (cross-portal audit).
# AUDIT_CROSS_PORTAL=1

# When 1, log JSON workflow/financial lines to stdout (status changes, receipts/expenses, scheduling actions).
# AUDIT_LOG=1

# When 1 with AUDIT_CROSS_PORTAL, echo x-impersonation-context header into cross-portal logs (opaque label only).
# IMPERSONATION_AUDIT=1
