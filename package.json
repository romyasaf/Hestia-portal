{
  "name": "hestia-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Hestia Portal — property management, tenant, staff, and owner operations",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @hestia/api dev",
    "dev:web": "pnpm --filter @hestia/web dev",
    "dev:mobile": "pnpm --filter @hestia/mobile dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
